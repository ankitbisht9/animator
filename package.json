{
  "name": "animator-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/web run build",
    "build:worker": "pnpm --filter @animator/engine-worker run build",
    "build:web": "pnpm --filter @animator/web run build",
    "dev": "node scripts/dev.mjs",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check . && pnpm run typecheck",
    "format": "biome format --write .",
    "codegen": "pnpm --filter @animator/engine run codegen"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2"
  }
}
