# Copy to `.env` and fill in the blanks. `.env` is git-ignored; never commit secrets.
# Every value here is configuration; nothing below is hardcoded in source.

# ---------------------------------------------------------------------------
# OpenAI (server-side only; never sent to the browser or the engine worker)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Leave empty for the SDK default (https://api.openai.com/v1).
OPENAI_BASE_URL=
# Responses API `store` flag (server-side data retention).
OPENAI_STORE=false
# Processing tier. priority ("Fast mode") writes about 1.6x faster for 2x the token price (about
# $0.03 per 30 s of lesson); leave empty for the standard tier (half the price, about 1.5x slower).
OPENAI_SERVICE_TIER=priority
# A scene takes about 20 s at low reasoning effort (1-2 minutes at high): raise this with the effort.
OPENAI_TIMEOUT_S=120
OPENAI_MAX_RETRIES=4
LLM_MAX_CONCURRENCY=16
# Hard stop per generation.
LLM_BUDGET_USD_PER_GENERATION=5.00
LLM_BUDGET_TOKENS_PER_GENERATION=2000000

# ---------------------------------------------------------------------------
# Fast and cheap defaults (ADR-032, ADR-033): gpt-6-luna at low effort for every stage. Generation keeps
# up with playback (a 30 s lesson in about 30 s) for about $0.03 per 30 s of lesson. Higher efforts (or
# gpt-6-sol) look a little better but take 2-5x longer; see docs/DECISIONS.md before changing them.
# Model per pipeline stage. IDs verified against
# https://developers.openai.com/api/docs/models on 2026-09-25.
# Reasoning effort: none | low | medium | high | xhigh | max
# ---------------------------------------------------------------------------
ANIMATOR_MODEL_EDUCATIONAL_PLANNER=gpt-6-luna
ANIMATOR_EFFORT_EDUCATIONAL_PLANNER=low
ANIMATOR_MODEL_STORYBOARD=gpt-6-luna
ANIMATOR_EFFORT_STORYBOARD=low
ANIMATOR_MODEL_ANIMATION_PLANNER=gpt-6-luna
ANIMATOR_EFFORT_ANIMATION_PLANNER=low
# Correction attempts 1..N-1 use this model...
ANIMATOR_MODEL_CORRECTION=gpt-6-luna
# Corrections fix a list of engine issues: low effort is enough and much faster.
ANIMATOR_EFFORT_CORRECTION=low
# ...and this one the last attempt (gpt-6-sol / high fixes more, but takes minutes).
ANIMATOR_MODEL_CORRECTION_FINAL=gpt-6-luna
ANIMATOR_EFFORT_CORRECTION_FINAL=low
ANIMATOR_MODEL_CRITIC=gpt-6-luna
ANIMATOR_EFFORT_CRITIC=medium
ANIMATOR_MODEL_VISUAL_CRITIC=gpt-6-luna
ANIMATOR_EFFORT_VISUAL_CRITIC=medium
ANIMATOR_MODEL_LIGHTWEIGHT=gpt-6-luna
ANIMATOR_EFFORT_LIGHTWEIGHT=low
# ---------------------------------------------------------------------------
# Teaching pipeline (ADR-044): how a lesson is made.
# teaching = a teacher writes the whole explanation, a reviewer checks and improves it, a visual
#            director plans every scene, then the scenes are drawn, looked at by a vision model
#            and framed (about 1.5-2.5 min for a 1-minute lesson; about $0.12-0.18).
# fast     = plan and storyboard in one call, as before ADR-044 (about 30 s, about $0.03-0.06).
# ---------------------------------------------------------------------------
ANIMATOR_PIPELINE=teaching
# Models of the teaching stages (empty = the storyboard's model).
ANIMATOR_MODEL_TEACHER=gpt-6-luna
ANIMATOR_EFFORT_TEACHER=medium
ANIMATOR_MODEL_REVIEWER=gpt-6-luna
ANIMATOR_EFFORT_REVIEWER=low
ANIMATOR_MODEL_DIRECTOR=gpt-6-luna
ANIMATOR_EFFORT_DIRECTOR=medium
# The reviewer's pass over the teacher's script (facts, depth, flow, delivery, length).
ANIMATOR_SCRIPT_REVIEW=true
# Scene drafts of teaching lessons (medium: far fewer failed scenes than low; corrections keep
# ANIMATOR_EFFORT_CORRECTION).
ANIMATOR_EFFORT_TEACHING_SCENE=medium
# Rendered keyframes of each scene, with the measured composition, go to the visual critic, which can
# ask for a round of fixes (1 = once per scene; 2 looks again after the fix, about 20 s more).
ANIMATOR_TEACHING_VISUAL_CRITIC=true
ANIMATOR_TEACHING_CRITIC_ROUNDS=1
# The camera frames each scene's content when it is small or off-centre (nothing moves; kept only
# when the engine confirms the framed scene is clean).
ANIMATOR_AUTO_FRAME=true
# A teaching lesson's labels that still cover, hide under or are crossed by something after the
# polish are tried in other places around what they name; the engine judges every try (ADR-046).
ANIMATOR_LABEL_RELOCATION=true
# How teaching lessons are laid out (ADR-047): classic (as the scene writer places things, then tidied)
# or planned (the scene writer adds a stage plan; a layout planner measures everything with the engine
# and places it precisely in the fixed frame; one draft per scene, plain slips repaired without a model
# call). A lesson can also choose it in the app (Layout). Switch back any time: classic.
ANIMATOR_LAYOUT_MODE=classic
# Drafts per scene and per correction round in the planned flow (1: no racing, cheaper).
ANIMATOR_PLANNED_SCENE_DRAFTS=1
ANIMATOR_PLANNED_CORRECTION_DRAFTS=1
# Lessons longer than this are planned the fast pipeline's way (in chapters).
ANIMATOR_TEACHING_MAX_DURATION_S=600

# Doubts (ADR-050, docs/DOUBTS.md): a learner raises a hand mid-lesson, asks by typing or speaking, and
# the tutor answers in one model call, reusing the lesson's own picture when the doubt is about it.
# false: no hand-raise button anywhere.
ANIMATOR_DOUBTS_ENABLED=true
# Empty: the teacher's model, then ANIMATOR_MODEL_FALLBACKS.
ANIMATOR_MODEL_DOUBT=
ANIMATOR_EFFORT_DOUBT=low
# The longest answer: this share of the lesson's length, kept between the least and the most (seconds).
ANIMATOR_DOUBT_SHARE=0.5
ANIMATOR_DOUBT_MIN_S=20
ANIMATOR_DOUBT_MAX_S=60
# What one lesson's doubts may cost in all (USD), and how many answers one doubt may have.
ANIMATOR_DOUBT_BUDGET_USD=0.5
ANIMATOR_DOUBT_MAX_TURNS=8
# Speech to text for browsers without built-in speech recognition (uses OPENAI_API_KEY).
ANIMATOR_DOUBT_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# USD per 1M tokens, per model. Edit the file, not the code.
ANIMATOR_PRICING_FILE=config/pricing.json
# If a stage's model is not available to your API key (404/403), these are tried in order.
# Cheap and capable: gpt-5-mini (reasoning), then gpt-4.1-mini (non-reasoning; effort is ignored).
ANIMATOR_MODEL_FALLBACKS=gpt-5-mini,gpt-4.1-mini
# What each model accepts (reasoning levels, vision). Edit the file, not the code.
ANIMATOR_MODELS_FILE=config/models.json
# openai = live calls; record = live calls also saved as replay fixtures;
# replay = offline, answered from fixtures (no key needed, used by tests).
ANIMATOR_LLM_PROVIDER=openai
ANIMATOR_LLM_FIXTURES_DIR=fixtures/llm/latest

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
ANIMATOR_MAX_CORRECTION_ATTEMPTS=3
ANIMATOR_ENABLE_LLM_CRITIC=false
ANIMATOR_ENABLE_VISUAL_CRITIC=false
# parallel: every scene starts on a clean stage and all scenes are generated at once (fast);
# sequential: each scene continues from the previous one's end state (objects carry over; slow).
ANIMATOR_SCENE_MODE=parallel
ANIMATOR_SCENE_CONCURRENCY=8
# Drafts written at once per scene; the first valid one wins (fewer correction rounds: faster and
# steadier, for about 1.5x the scene cost). 1 = a single draft.
ANIMATOR_SCENE_DRAFTS=2
# The same for each correction round (patches are small: about $0.002 each).
ANIMATOR_CORRECTION_DRAFTS=2
# Corrections reply with only what changes instead of the whole scene (seconds instead of ~20 s).
ANIMATOR_PATCH_CORRECTIONS=true
# Tidy each valid scene's layout with the engine's hints (labels off objects, arrows rerouted around
# things, nothing under the caption). No model call; a fraction of a second per scene.
ANIMATOR_LAYOUT_POLISH=true
# Lessons up to this long are planned and storyboarded in one call.
ANIMATOR_OUTLINE_MAX_DURATION_S=150
ANIMATOR_CHUNK_TARGET_DURATION_S=75
ANIMATOR_CHUNK_MAX_DURATION_S=120
ANIMATOR_BUFFER_TARGET_SECONDS=90
ANIMATOR_MIN_READY_SCENES=2
# Allowed deviation of planned total duration from the requested duration (fraction).
ANIMATOR_DURATION_TOLERANCE=0.15
# Lessons generated at the same time; each generates its scenes one after another.
ANIMATOR_GENERATION_CONCURRENCY=2
ANIMATOR_SCENE_MAX_OUTPUT_TOKENS=48000
ANIMATOR_VISUAL_CRITIC_KEYFRAMES=3

# ---------------------------------------------------------------------------
# Narration audio: text to speech (ADR-037, ADR-038, docs/TTS.md)
# ONE switch: 1 = the captions are spoken (word-synced), 0 = no voice anywhere
# (pipeline, API, player and export behave exactly as without this feature).
# Write each setting ONCE: when a name appears twice, only the last one counts.
# ---------------------------------------------------------------------------
ANIMATOR_TTS_ENABLED=0
# edge       = free Microsoft neural voices, no key or account (fast)
# kokoro     = free local Kokoro-82M server (Kokoro-FastAPI), offline: set ANIMATOR_TTS_BASE_URL
# azure      = Microsoft voices, official Azure Speech free tier (500K chars/month): AZURE_SPEECH_*
# google     = Google Cloud Text-to-Speech (1M chars/month free on Neural2): GOOGLE_TTS_API_KEY
# elevenlabs = most expressive voices (10K credits/month free): ELEVENLABS_API_KEY
# openai     = OpenAI TTS (paid, uses OPENAI_API_KEY) or any OpenAI-compatible server
ANIMATOR_TTS_PROVIDER=edge
# kokoro: the Kokoro server (empty = http://localhost:8880);
# openai: an OpenAI-compatible server (empty = api.openai.com).
ANIMATOR_TTS_BASE_URL=
# Voice of English lessons. Empty = the provider's default: kokoro af_heart,
# edge/azure en-US-AvaMultilingualNeural, google en-US-Neural2-F, elevenlabs JBFqnCBsd6RMkjVDRZzb, openai coral.
ANIMATOR_TTS_VOICE=
# Hinglish lessons: provider and voice. Empty provider = the one above. Kokoro reads Roman-script
# Hinglish with English sounds, so use edge for Hinglish: its hi-IN-SwaraNeural is a native Hindi
# female voice (free, no key). Empty voice = the provider's Hinglish default: edge/azure
# hi-IN-SwaraNeural, google en-IN-Neural2-A, kokoro hf_alpha, elevenlabs/openai the English voice.
ANIMATOR_TTS_PROVIDER_HINGLISH=
ANIMATOR_TTS_VOICE_HINGLISH=
# 1.0 = normal speaking rate (0.5 - 2.0).
ANIMATOR_TTS_SPEED=1.0
# elevenlabs: eleven_v4 (recommended: the most natural teacher, about 130 words a minute, 60% more
# pitch variation than flash, takes audio tags; about 1 credit per character after its launch discount)
# | eleven_flash_v2_5 (fastest, half the credits, fast and flatter, about 200 words a minute)
# | eleven_multilingual_v2 (default) | eleven_v3; openai: gpt-4o-mini-tts
ANIMATOR_TTS_MODEL=
# openai gpt-4o-mini-tts only: tone of voice, e.g. "Speak like a warm, enthusiastic teacher."
ANIMATOR_TTS_INSTRUCTIONS=
# openai provider: empty = OPENAI_API_KEY (api.openai.com) or no key (local server).
ANIMATOR_TTS_API_KEY=
# Keys for the other providers (leave empty unless you use that provider).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
# 1 = each scene's narration is spoken in one take (ADR-043): the voice reads the whole scene in one
# go, with only the natural pauses of its punctuation; 0 = sentence by sentence (ADR-041).
ANIMATOR_TTS_ONE_TAKE=1
# Quiet between two scenes: seconds after a scene's last word before the next scene.
ANIMATOR_TTS_SCENE_PAUSE_S=1.0
# Sentence by sentence only: silence from a sentence's last word to the next sentence (ADR-041).
ANIMATOR_TTS_PAUSE_S=0.35
# 1 = each sentence's time is fitted to its speech (long silences after a sentence are removed,
# never below what its animations need; kept only when the scene stays valid). 0 = beats only grow.
ANIMATOR_TTS_FIT_BEATS=1
# Speech script (ADR-041): a small model call rewrites each caption for the voice (Hindi words in
# Devanagari so they are pronounced right, spoken punctuation, a tone). The captions never change.
# hinglish = Hinglish lessons only; all = every lesson; off = the captions are read as written.
ANIMATOR_TTS_SCRIPT=hinglish
# elevenlabs delivery: stability (lower = more expressive, less even; eleven_v3 accepts 0, 0.5, 1)
# and style (higher = more emotion, a little slower).
ANIMATOR_TTS_STABILITY=0.4
ANIMATOR_TTS_STYLE=0.3
# Voice modulation (ADR-045): the speech script also directs HOW each sentence is said (tone, pace,
# stressed words, a pause before a key point), knowing what the picture shows. Eleven v3/v4 get it as
# audio tags and capitals; for every model a teacher's timing is applied to the audio: at least this
# pause after a full stop, a comma and before a key point, and slow sentences (definitions,
# equations) at this tempo (pitch unchanged). Highlights move to the moment their thing is named.
# 0 = speech exactly as before ADR-045.
ANIMATOR_TTS_PROSODY=1
ANIMATOR_TTS_SENTENCE_PAUSE_S=0.4
ANIMATOR_TTS_COMMA_PAUSE_S=0.18
ANIMATOR_TTS_KEY_PAUSE_S=0.35
ANIMATOR_TTS_SLOW_TEMPO=0.9
ANIMATOR_TTS_SYNC_HIGHLIGHTS=1
# Sentences synthesized at once: 1 for kokoro on a CPU (it then speaks the first scene first),
# 8 for edge and the cloud providers; ElevenLabs allows 2 (free) to 5 (creator) at once.
ANIMATOR_TTS_CONCURRENCY=8
# Seconds allowed per sentence; kokoro on a CPU needs about as long as the sentence lasts.
ANIMATOR_TTS_TIMEOUT_S=30
# Synthesized speech, by content (the same sentence is never synthesized twice).
ANIMATOR_TTS_CACHE_DIR=var/tts

# ---------------------------------------------------------------------------
# Storage: no database for now (ADR-003). memory = in-process only;
# files = JSON records under ANIMATOR_DATA_DIR/generations (survive restarts; resumable).
# ---------------------------------------------------------------------------
ANIMATOR_STORAGE_BACKEND=files
ANIMATOR_DATA_DIR=var

# ---------------------------------------------------------------------------
# Engine worker (Node child process, JSON-RPC over stdio)
# ---------------------------------------------------------------------------
ENGINE_WORKER_NODE=node
ENGINE_WORKER_SCRIPT=packages/engine-worker/dist/worker.cjs
ENGINE_WORKER_POOL_SIZE=4
ENGINE_WORKER_CALL_TIMEOUT_S=30
ENGINE_WORKER_MAX_RESTARTS=5

# ---------------------------------------------------------------------------
# API server / web dev server
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
WEB_DEV_PORT=5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Video export (Playwright + ffmpeg)
# ---------------------------------------------------------------------------
EXPORT_FPS=30
EXPORT_WIDTH=1920
EXPORT_HEIGHT=1080
EXPORT_CRF=18
EXPORT_WORKERS=4
# comma-separated: mp4,webm
EXPORT_FORMATS=mp4
EXPORT_OUTPUT_DIR=var/exports
FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# The platform: accounts, roles, the gateway (docs/PLATFORM.md). All optional.
# ---------------------------------------------------------------------------
# false: the API as before accounts (development only)
PLATFORM_ENABLED=true
# development | production (production: Secure cookies, strict origins, no first-account admin)
PLATFORM_ENVIRONMENT=development
# Empty: SQLite in var/platform/. Or postgresql+asyncpg://user:pass@host/db
PLATFORM_DATABASE_URL=
# Empty: generated once into var/platform/secret.key. Set it in production (48+ random characters).
PLATFORM_SECRET_KEY=
# Emails that are admins as soon as they sign up (comma separated)
PLATFORM_ADMIN_EMAILS=
PLATFORM_ALLOW_SIGNUP=true
PLATFORM_REQUIRE_VERIFIED_EMAIL=false
# Mail links point here
PLATFORM_PUBLIC_BASE_URL=http://localhost:5173
# Outgoing mail; empty host: mails are written to var/platform/outbox/
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_FROM=Animator <no-reply@localhost>
# Quotas per rolling 24 hours (0 = no limit) and the longest lesson per role
PLATFORM_LESSONS_PER_DAY_LEARNER=5
PLATFORM_LESSONS_PER_DAY_EDUCATOR=25
PLATFORM_DOUBTS_PER_DAY_LEARNER=40
PLATFORM_DOUBTS_PER_DAY_EDUCATOR=120
PLATFORM_MAX_MINUTES_LEARNER=10
PLATFORM_MAX_MINUTES_EDUCATOR=20
# Production: serve the built web app from the API (one origin), trusted hosts, HSTS
PLATFORM_SERVE_WEB=false
PLATFORM_TRUSTED_HOSTS=*
PLATFORM_HSTS=false
