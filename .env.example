# Copy to `.env` and fill in the blanks. `.env` is git-ignored; never commit secrets.
# Every value here is configuration; nothing below is hardcoded in source.

# ---------------------------------------------------------------------------
# OpenAI (server-side only; never sent to the browser or the engine worker)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
# Leave empty for the SDK default (https://api.openai.com/v1).
OPENAI_BASE_URL=
# Responses API `store` flag (server-side data retention).
OPENAI_STORE=false
OPENAI_TIMEOUT_S=120
OPENAI_MAX_RETRIES=4
LLM_MAX_CONCURRENCY=4
# Hard stop per generation.
LLM_BUDGET_USD_PER_GENERATION=5.00
LLM_BUDGET_TOKENS_PER_GENERATION=2000000

# ---------------------------------------------------------------------------
# Model per pipeline stage. IDs verified against
# https://developers.openai.com/api/docs/models on 2026-09-25.
# Reasoning effort: none | low | medium | high | xhigh | max
# ---------------------------------------------------------------------------
ANIMATOR_MODEL_EDUCATIONAL_PLANNER=gpt-6-sol
ANIMATOR_EFFORT_EDUCATIONAL_PLANNER=high
ANIMATOR_MODEL_STORYBOARD=gpt-6-sol
# The spec asks for "medium-high"; the API has no such level, so this starts at high.
ANIMATOR_EFFORT_STORYBOARD=high
ANIMATOR_MODEL_ANIMATION_PLANNER=gpt-6-sol
ANIMATOR_EFFORT_ANIMATION_PLANNER=high
# Correction attempts 1..N-1 use this model...
ANIMATOR_MODEL_CORRECTION=gpt-6-sol
ANIMATOR_EFFORT_CORRECTION=high
# ...and the final attempt escalates to the flagship.
ANIMATOR_MODEL_CORRECTION_FINAL=gpt-6-astra
ANIMATOR_EFFORT_CORRECTION_FINAL=high
ANIMATOR_MODEL_CRITIC=gpt-6-sol
ANIMATOR_EFFORT_CRITIC=medium
ANIMATOR_MODEL_VISUAL_CRITIC=gpt-6-sol
ANIMATOR_EFFORT_VISUAL_CRITIC=medium
ANIMATOR_MODEL_LIGHTWEIGHT=gpt-6-luna
ANIMATOR_EFFORT_LIGHTWEIGHT=low
# USD per 1M tokens, per model. Edit the file, not the code.
ANIMATOR_PRICING_FILE=config/pricing.json
# If a stage's model is not available to your API key (404/403), these are tried in order.
# gpt-5 (reasoning), then gpt-4.1 and gpt-4o (non-reasoning; effort is ignored for them).
ANIMATOR_MODEL_FALLBACKS=gpt-5,gpt-4.1,gpt-4o
# What each model accepts (reasoning levels, vision). Edit the file, not the code.
ANIMATOR_MODELS_FILE=config/models.json
# openai = live calls; record = live calls also saved as replay fixtures;
# replay = offline, answered from fixtures (no key needed, used by tests).
ANIMATOR_LLM_PROVIDER=openai
ANIMATOR_LLM_FIXTURES_DIR=fixtures/llm/latest

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
ANIMATOR_MAX_CORRECTION_ATTEMPTS=3
ANIMATOR_ENABLE_LLM_CRITIC=false
ANIMATOR_ENABLE_VISUAL_CRITIC=false
ANIMATOR_CHUNK_TARGET_DURATION_S=75
ANIMATOR_CHUNK_MAX_DURATION_S=120
ANIMATOR_BUFFER_TARGET_SECONDS=90
ANIMATOR_MIN_READY_SCENES=2
# Allowed deviation of planned total duration from the requested duration (fraction).
ANIMATOR_DURATION_TOLERANCE=0.15
# Lessons generated at the same time; each generates its scenes one after another.
ANIMATOR_GENERATION_CONCURRENCY=2
ANIMATOR_SCENE_MAX_OUTPUT_TOKENS=48000
ANIMATOR_VISUAL_CRITIC_KEYFRAMES=3

# ---------------------------------------------------------------------------
# Storage: no database for now (ADR-003). memory = in-process only;
# files = JSON records under ANIMATOR_DATA_DIR/generations (survive restarts; resumable).
# ---------------------------------------------------------------------------
ANIMATOR_STORAGE_BACKEND=files
ANIMATOR_DATA_DIR=var

# ---------------------------------------------------------------------------
# Engine worker (Node child process, JSON-RPC over stdio)
# ---------------------------------------------------------------------------
ENGINE_WORKER_NODE=node
ENGINE_WORKER_SCRIPT=packages/engine-worker/dist/worker.cjs
ENGINE_WORKER_POOL_SIZE=2
ENGINE_WORKER_CALL_TIMEOUT_S=30
ENGINE_WORKER_MAX_RESTARTS=5

# ---------------------------------------------------------------------------
# API server / web dev server
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
WEB_DEV_PORT=5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Video export (Playwright + ffmpeg)
# ---------------------------------------------------------------------------
EXPORT_FPS=30
EXPORT_WIDTH=1920
EXPORT_HEIGHT=1080
EXPORT_CRF=18
EXPORT_WORKERS=4
# comma-separated: mp4,webm
EXPORT_FORMATS=mp4
EXPORT_OUTPUT_DIR=var/exports
FFMPEG_PATH=ffmpeg
