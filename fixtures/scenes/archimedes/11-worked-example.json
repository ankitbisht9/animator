{
  "dsl_version": "1.0",
  "id": "s11_worked_example",
  "title": "A worked example",
  "educational_purpose": "Plug real numbers into the equation (computed by the engine) and check the result against the scale measurement.",
  "duration": 27,
  "layout": "stage_with_equation",
  "narration": {
    "beats": [
      {
        "id": "b1",
        "text": "Let's check with real numbers. Our stone is a 10 cm cube: 1 litre, which is 0.001 cubic metres.",
        "at": 0
      },
      {
        "id": "b2",
        "text": "Put in the density of water, the volume and g.",
        "at": 7
      },
      {
        "id": "b3",
        "text": "Multiply them, and out comes the buoyant force.",
        "at": 13
      },
      {
        "id": "b4",
        "text": "It matches the weight the stone lost on the scale. The principle **works**!",
        "at": 19.5
      }
    ]
  },
  "values": [
    {
      "id": "rho_w",
      "value": 1000,
      "unit": "kg/m³",
      "description": "Density of water"
    },
    {
      "id": "vol",
      "value": 0.001,
      "unit": "m³",
      "description": "Volume of the stone (1 litre)"
    },
    {
      "id": "grav",
      "value": 9.81,
      "unit": "N/kg",
      "description": "Gravity"
    },
    {
      "id": "fb",
      "expr": "rho_w * vol * grav",
      "unit": "N",
      "description": "Buoyant force"
    }
  ],
  "objects": [
    {
      "id": "title_s11",
      "type": "text",
      "params": {
        "text": "Let's check with numbers",
        "size": "heading",
        "weight": "bold"
      },
      "place": {
        "slot": "title_bar"
      },
      "layer": "overlay"
    },
    {
      "id": "eq_num",
      "type": "equation",
      "params": {
        "parts": [
          {
            "id": "eq",
            "tex": "="
          },
          {
            "id": "n1",
            "tex": "1000"
          },
          {
            "id": "x1",
            "tex": "\\times"
          },
          {
            "id": "n2",
            "tex": "0.001"
          },
          {
            "id": "x2",
            "tex": "\\times"
          },
          {
            "id": "n3",
            "tex": "9.81"
          }
        ],
        "size": 54
      },
      "place": {
        "slot": "equation_panel.center",
        "offset": {
          "x": 0,
          "y": -100
        }
      }
    },
    {
      "id": "u1",
      "type": "label",
      "params": {
        "text": "kg/m³",
        "style": "plain",
        "color": "muted",
        "size": "small"
      },
      "place": {
        "at": "eq_num.term_n1",
        "anchor": "top",
        "offset": {
          "x": 0,
          "y": 36
        }
      }
    },
    {
      "id": "u2",
      "type": "label",
      "params": {
        "text": "m³",
        "style": "plain",
        "color": "muted",
        "size": "small"
      },
      "place": {
        "at": "eq_num.term_n2",
        "anchor": "top",
        "offset": {
          "x": 0,
          "y": 36
        }
      }
    },
    {
      "id": "u3",
      "type": "label",
      "params": {
        "text": "N/kg",
        "style": "plain",
        "color": "muted",
        "size": "small"
      },
      "place": {
        "at": "eq_num.term_n3",
        "anchor": "top",
        "offset": {
          "x": 0,
          "y": 36
        }
      }
    },
    {
      "id": "res",
      "type": "readout",
      "params": {
        "label": "Buoyant force",
        "value": {
          "bind": "fb"
        },
        "format": "0.0",
        "unit": "N",
        "role": "force_buoyant"
      },
      "place": {
        "relativeTo": "eq_num",
        "side": "below",
        "gap": 70
      }
    },
    {
      "id": "lost",
      "type": "readout",
      "params": {
        "label": "Weight lost on the scale",
        "value": {
          "bind": "hold11.weight - hold11.apparentWeight"
        },
        "format": "0.0",
        "unit": "N",
        "role": "force_applied",
        "size": "body"
      },
      "place": {
        "relativeTo": "res",
        "side": "below",
        "gap": 24
      }
    },
    {
      "id": "match",
      "type": "badge",
      "params": {
        "text": "SAME!",
        "role": "positive",
        "icon": "check",
        "size": "label"
      },
      "place": {
        "relativeTo": "lost",
        "side": "below",
        "gap": 20
      }
    }
  ],
  "solvers": [
    {
      "id": "hold11",
      "type": "buoyancy",
      "container": "can",
      "body": "stone",
      "mode": "hold",
      "catchContainer": "cup",
      "scale": "sc",
      "unitsPerMeter": 1000
    }
  ],
