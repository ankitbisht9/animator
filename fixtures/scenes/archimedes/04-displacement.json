{
  "dsl_version": "1.0",
  "id": "s04_displacement",
  "title": "Pushing water aside",
  "educational_purpose": "Show displacement: to go in, the block must push water out of the way, and that water can only go up.",
  "duration": 23,
  "layout": "stage_with_caption",
  "narration": {
    "beats": [
      {
        "id": "b1",
        "text": "Let's lift the block out, mark the water level, and lower it back in slowly.",
        "at": 0
      },
      {
        "id": "b2",
        "text": "To get in, the block has to **push water out of the way**.",
        "at": 6.5
      },
      {
        "id": "b3",
        "text": "The water it pushes aside is called the **displaced water**.",
        "at": 12.5
      },
      {
        "id": "b4",
        "text": "That water has nowhere to go, except **up**.",
        "at": 18
      }
    ]
  },
