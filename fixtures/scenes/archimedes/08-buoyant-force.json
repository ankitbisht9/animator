{
  "dsl_version": "1.0",
  "id": "s08_buoyant_force",
  "title": "Force 2: the buoyant force",
  "educational_purpose": "Introduce the upward buoyant force, show it balances the weight while floating, and that pushing deeper increases it.",
  "duration": 26,
  "layout": "stage_with_caption",
  "narration": {
    "beats": [
      { "id": "b1", "text": "But the block doesn't sink to the bottom. The water pushes **up** on it!", "at": 0 },
      { "id": "b2", "text": "This upward push is called the **buoyant force**.", "at": 6 },
      { "id": "b3", "text": "While the block floats, the two forces **balance**: the push up equals the weight.", "at": 11.5 },
      { "id": "b4", "text": "Push the block deeper, and the water pushes back even **harder**!", "at": 18 }
    ]
  },
  "objects": [
    { "id": "title_s08", "type": "text", "params": { "text": "Force 2: the buoyant force", "size": "heading", "weight": "bold" }, "place": { "slot": "title_bar" }, "layer": "overlay" },
    {
      "id": "f_b",
      "type": "vector_arrow",
      "params": { "from": "blk.center", "direction": "up", "magnitude": { "bind": "push8.buoyantForce" }, "scale": 16, "role": "force_buoyant", "label": { "bind": "push8.buoyantForce", "format": "F_{b} = 0.0 N" }, "labelSide": "right" },
      "layer": "foreground",
      "metadata": { "name": "Buoyant force", "description": "The water pushes up on the block. The deeper it sits, the bigger the push." }
    },
    { "id": "bal", "type": "badge", "params": { "text": "BALANCED", "role": "positive", "icon": "balance", "size": "label" }, "place": { "relativeTo": "tank", "side": "right", "gap": 200, "align": "start" } },
