    { "id": "harder", "type": "badge", "params": { "text": "BIGGER PUSH BACK", "role": "force_buoyant", "icon": "arrow_up", "size": "label" }, "place": { "relativeTo": "tank", "side": "right", "gap": 200, "align": "start" } }
