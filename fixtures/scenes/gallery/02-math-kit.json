{
  "dsl_version": "1.0",
  "id": "kit_math",
  "title": "Math kit",
  "duration": 11,
  "layout": "stage_with_equation",
  "transition_in": {
    "type": "fade",
    "duration": 0.5
  },
  "narration": {
    "beats": [
      {
        "id": "b1",
        "text": "Equations build up **one term at a time**."
      },
      {
        "id": "b2",
        "text": "We can light up the term we are talking about."
      },
      {
        "id": "b3",
        "text": "Graphs, readouts and cards summarize the idea."
      }
    ]
  },
  "values": [
    {
      "id": "rho",
      "value": 1000
    },
    {
      "id": "vol",
      "value": 0.0004
    },
    {
      "id": "g",
      "value": 9.81
    },
    {
      "id": "fb",
      "expr": "rho * vol * g"
    }
  ],
  "objects": [
    {
      "id": "title",
      "type": "text",
      "params": {
        "text": "Math **kit**",
        "size": "heading",
        "weight": "bold"
      },
      "place": {
        "slot": "title_bar"
      }
    },
    {
      "id": "eq",
      "type": "equation",
      "params": {
        "parts": [
          {
            "id": "fb",
            "tex": "F_b"
          },
          {
            "id": "eq",
            "tex": "="
          },
          {
            "id": "rho",
            "tex": "\\rho"
          },
          {
            "id": "v",
            "tex": "V"
          },
          {
            "id": "g",
            "tex": "g"
          }
        ],
        "size": 64,
        "box": true
      },
      "place": {
        "slot": "equation_panel.top"
      }
    },
    {
      "id": "result",
      "type": "readout",
      "params": {
        "label": "Buoyant force",
        "value": {
          "bind": "fb"
        },
        "format": "0.00",
        "unit": "N",
        "role": "force_buoyant"
      },
      "place": {
        "relativeTo": "eq",
        "side": "below",
        "gap": 36
      }
    },
    {
      "id": "plot",
      "type": "graph",
      "params": {
        "width": 440,
        "height": 250,
        "x": {
          "min": 0,
          "max": 12.6,
          "label": "x"
        },
        "y": {
          "min": -1.3,
          "max": 1.3,
          "label": "wave"
        },
        "series": [
          {
            "id": "w",
            "expr": "sin(x - 2*t)",
            "role": "accent"
          },
          {
            "id": "d",
            "expr": "0.6*cos(0.5*x)",
            "role": "positive",
            "style": "area"
          }
        ]
      },
      "place": {
        "slot": "stage.top",
        "offset": {
          "x": 0,
          "y": 30
        }
      }
    },
    {
      "id": "summary",
      "type": "card",
      "params": {
        "title": "Remember",
        "items": [
          "Water pushes **up** on anything in it.",
          "The push equals the weight of water moved aside."
        ],
        "width": 560
      },
      "place": {
        "slot": "stage.bottom",
        "offset": {
          "x": 60,
          "y": -20
        }
      }
    },
    {
      "id": "tip",
      "type": "note",
      "params": {
        "title": "Key idea",
        "icon": "lightbulb",
        "text": "Density decides: float or sink.",
        "width": 400,
        "role": "highlight"
      },
      "place": {
        "relativeTo": "result",
        "side": "below",
        "gap": 30
      }
    },
    {
      "id": "about_rho",
      "type": "callout",
      "params": {
        "text": "ρ is the **density** of the fluid",
        "target": "eq.term_rho",
        "maxWidth": 250
      },
      "place": {
        "relativeTo": "eq",
        "side": "left",
        "gap": 70,
        "align": "start"
      }
    }
  ],
  "timeline": [
    {
      "id": "w0",
      "action": "write",
      "target": "title",
      "start": {
        "at": 0.1
      }
    },
    {
      "id": "w1",
      "action": "write",
      "target": "eq",
      "terms": [
        "fb",
        "eq",
        "rho",
        "v",
        "g"
      ],
      "start": {
        "at": 0.6
      },
      "duration": 2.4
    },
    {
      "id": "h1",
      "action": "highlight",
      "target": "eq",
      "terms": [
        "rho"
      ],
      "style": "color",
      "start": {
        "at": "beat:b2"
      },
      "duration": 2.4
    },
    {
      "id": "c1",
      "action": "create",
      "target": "about_rho",
      "start": {
        "with": "h1",
        "delay": 0.2
      }
    },
    {
      "id": "c2",
      "action": "create",
      "target": "result",
      "start": {
        "after": "c1"
      },
      "duration": 1.2
    },
    {
      "id": "g1",
      "action": "create",
      "target": "plot",
      "start": {
        "at": "beat:b3"
      },
      "duration": 1.6
    },
    {
      "id": "c3",
      "action": "create",
      "target": "summary",
      "start": {
        "after": "g1",
        "delay": -0.6
      },
      "duration": 1.8
    },
    {
      "id": "c4",
      "action": "create",
      "target": "tip",
      "start": {
        "with": "c3",
        "delay": 0.8
      }
    }
  ]
}
